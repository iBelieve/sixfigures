{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sixfigures",
  "compatibility_date": "2026-09-01",
  // Static assets only; no Worker script.
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "sixfigures.mspencer.io", "custom_domain": true }
  ],
  // Workers Builds deploys non-production branches with `wrangler preview`,
  // which requires this block even when Preview settings match production.
  "previews": {}
}
